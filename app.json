{
  "expo": {
    "name": "SafarMile",
    "slug": "safarmate",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9FAFB"
    },
    "scheme": "safarmile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.safarmile.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SafarMile needs camera access to verify your identity.",
        "NSPhotoLibraryUsageDescription": "SafarMile needs photo access to upload your profile picture and ID documents.",
        "NSLocationWhenInUseUsageDescription": "SafarMile needs your location to find rides near you."
      }
    },
    "android": {
      "package": "com.safarmile.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9FAFB",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e323e46-8dd5-48e3-a654-6244052714f2"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/7e323e46-8dd5-48e3-a654-6244052714f2"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
