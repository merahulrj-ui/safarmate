rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Prevent privilege escalation by blocking edits to sensitive fields
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['role', 'verified', 'govtIdStatus']));
                    
      allow update: if isAdmin() || (
                      isAuthenticated() && request.auth.uid == userId
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verified']))
                      && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['govtIdStatus']) ||
                        request.resource.data.govtIdStatus == 'pending'
                      )
                    );
                    
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    match /rides/{rideId} {
      function isDriver() {
        return request.auth.uid == resource.data.driverId;
      }
      // Passenger booking constraints
      function isValidPassengerUpdate() {
        let diff = request.resource.data.diff(resource.data);
        return diff.affectedKeys().hasOnly(['bookings', 'seatsAvailable', 'passengerIds'])
               && request.resource.data.driverId == resource.data.driverId // Passenger shouldn't change driverId
               && request.resource.data.seatsAvailable >= 0
               && request.resource.data.seatsAvailable <= resource.data.seatsAvailable // Seats can decrease or stay same
               && (request.auth.uid in request.resource.data.passengerIds); // Must add themselves
      }

      function isValidRideData() {
        let incoming = request.resource.data;
        return (incoming.price is number && incoming.price > 0) &&
               (incoming.seatsAvailable is number && incoming.seatsAvailable >= 0 && incoming.seatsAvailable <= 6);
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.driverId == request.auth.uid && isValidRideData();
      
      // Driver can update anything (valid data), Passenger can only update booking/seats safely
      allow update: if isAuthenticated() && (
        (isDriver() && isValidRideData() && request.resource.data.driverId == resource.data.driverId) || 
        (isValidPassengerUpdate() && isValidRideData())
      );
      
      allow delete: if isAuthenticated() && isDriver();
    }

    match /conversations/{conversationId} {
      // Only participants can read/write conversations
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() 
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants; // Prevent changing participants
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() 
                      && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && !('team' in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        allow delete: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /notifications/{notificationId} {
      // Only the owner can read their notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Allow any logged in user to create a notification (e.g. driver accepting sends to passenger)
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUserId;
      allow update, delete: if false; // Ratings cannot be changed or deleted
    }

    match /settings/{document=**} {
      allow read: if isAdmin();
    }

    match /login_security/{email} {
      // Rate-limit tracking - restricted writes. Move to Cloud Function for production.
      allow read: if isAuthenticated();
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
